# Slack Bot Token (OAuth & Permissions ページで発行) 例: xoxb-...
SLACK_BOT_TOKEN=xoxb-your-bot-token

# Slack App-Level Token (Socket Mode 用、connections:write スコープ) 例: xapp-...
SLACK_APP_TOKEN=xapp-your-app-token

# Slack Signing Secret (Basic Information ページ)
SLACK_SIGNING_SECRET=your-signing-secret

# お誘いの有効時間(分)。この時間を過ぎた「行く/あとで」ボタンは無効になります
REQUEST_TTL_MINUTES=20
