# LINE Developers コンソール > Messaging API設定 で発行するチャネルアクセストークン(長期)
LINE_CHANNEL_ACCESS_TOKEN=your-long-lived-channel-access-token

# LINE Developers コンソール > チャネル基本設定 で確認できるチャネルシークレット
LINE_CHANNEL_SECRET=your-channel-secret

# サーバーの待受ポート
PORT=3000

# お誘いの有効時間(分)。この時間を過ぎた「行く/あとで」ボタンは無効になります
REQUEST_TTL_MINUTES=20
